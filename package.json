{
  "name": "link",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint && pnpm lint:rtl",
    "lint:rtl": "node scripts/check-rtl.mjs",
    "typecheck": "turbo run typecheck",
    "i18n:check": "node packages/i18n/scripts/check-keys.mjs",
    "i18n:export-review": "node packages/i18n/scripts/review-strings.mjs export",
    "i18n:apply-review": "node packages/i18n/scripts/review-strings.mjs apply",
    "ai:eval": "node scripts/ai-eval.mjs",
    "ai:ingest-recordings": "uv --directory apps/ai-service run python scripts/ingest_recordings.py",
    "ai:bench": "uv --directory apps/ai-service run python scripts/bench_stt.py",
    "ai:models": "uv --directory apps/ai-service run python scripts/download_models.py",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "pnpm --filter @link/ui storybook",
    "dev:infra": "node scripts/dev-infra.mjs",
    "dev:reset": "node scripts/dev-reset.mjs",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:rollback": "node scripts/db.mjs rollback",
    "db:status": "node scripts/db.mjs status",
    "db:seed": "node scripts/db.mjs seed",
    "env:check": "node scripts/env-check.mjs",
    "test:e2e": "pnpm --filter @link/web test:e2e",
    "mock:server": "pnpm --filter @link/mocks mock:server",
    "scenario:demo-followup": "node scripts/demo-scenario.mjs",
    "demo": "node scripts/demo.mjs",
    "demo:warm": "node scripts/demo-warm.mjs",
    "pilot:init": "pnpm --filter @link/pilot run init",
    "pilot:cert": "pnpm --filter @link/pilot run cert",
    "pilot:import": "pnpm --filter @link/pilot run import",
    "pilot:build": "node apps/pilot/scripts/build-apps.mjs",
    "pilot:check": "pnpm --filter @link/pilot run check",
    "pilot:preflight": "pnpm --filter @link/pilot run preflight",
    "pilot:practice": "pnpm --filter @link/pilot run practice",
    "pilot:practice-wipe": "pnpm --filter @link/pilot run practice-wipe",
    "pilot:guides": "node scripts/pilot-guides.mjs",
    "testing:walkthrough": "node scripts/pilot-guides.mjs --walkthrough",
    "pilot:start": "node apps/pilot/scripts/start.mjs",
    "pilot:backup": "pnpm --filter @link/pilot run backup",
    "pilot:restore": "pnpm --filter @link/pilot run restore",
    "pilot:reset-pin": "pnpm --filter @link/pilot run reset-pin",
    "pilot:metrics": "pnpm --filter @link/pilot run metrics",
    "pilot:wipe": "pnpm --filter @link/pilot run wipe"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@link/config": "workspace:*",
    "eslint": "^10.11.0",
    "opentype.js": "^2.0.0",
    "playwright": "^1.63.0",
    "prettier": "^3",
    "sharp": "^0.35.5",
    "turbo": "^2",
    "typescript": "^5",
    "typescript-eslint": "^8.71.0"
  }
}
