{
  "name": "link",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint && pnpm lint:rtl",
    "lint:rtl": "node scripts/check-rtl.mjs",
    "typecheck": "turbo run typecheck",
    "i18n:check": "node packages/i18n/scripts/check-keys.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "pnpm --filter @link/ui storybook"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@link/config": "workspace:*",
    "eslint": "^10.11.0",
    "prettier": "^3",
    "turbo": "^2",
    "typescript": "^5",
    "typescript-eslint": "^8.71.0"
  }
}
