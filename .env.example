# Link — environment variables (docs/14-dev-environment.md §3).
# Names and purpose only. NEVER commit values. Copy to `.env.local` (git-ignored) for local runs;
# staging and prod read from the secrets manager. `pnpm env:check` fails if code uses a name
# that is not listed here.

# ── Shared ─────────────────────────────────────────────────────────────────────
APP_ENV=                       # local | dev | staging | prod
LOG_LEVEL=                     # debug | info | warn | error
OTEL_EXPORTER_OTLP_ENDPOINT=   # OpenTelemetry collector (empty = off)
SENTRY_DSN=                    # Error reporting (empty = off)
POSTHOG_KEY=                   # Product analytics, no personal data (empty = off)
FEATURE_FLAGS_BOOTSTRAP=       # Default flags for a fresh environment (JSON)

# ── core-api (api, workers, messaging-gateway) ─────────────────────────────────
DATABASE_URL=                  # Connection as app_user (RLS enforced)
DATABASE_URL_WORKER=           # Connection as app_worker
DATABASE_URL_OPS=              # Connection as app_ops
DATABASE_URL_MIGRATOR=         # Migrations and seed only
DATABASE_REPLICA_URL=          # Read replica (search, reports); locally the primary
REDIS_CACHE_URL=               # Cache instance (allkeys-lru)
REDIS_STATE_URL=               # State instance (noeviction, AOF)
S3_ENDPOINT=                   # Object storage (aws-local locally)
S3_REGION=
S3_BUCKET_VOICE=
S3_BUCKET_MEDIA=
S3_BUCKET_EXPORTS=
KMS_KEY_STORAGE=               # Storage encryption key (alias)
KMS_KEY_FIELDS=                # Field-level (envelope) encryption key (alias)
HMAC_KEY_LOOKUP=               # Key for phone and contact HMAC lookup columns
FIELD_KEY_LOCAL=               # local only: key-encryption key for field encryption (base64, 32 bytes); aws-local keeps KMS keys in memory, so local data would not survive a restart. Elsewhere KMS_KEY_FIELDS wraps the data keys
CORE_API_PORT=                 # core-api HTTP port (default 4000)
GATEWAY_PORT=                  # messaging-gateway health and (R3) webhook port (default 4002)
CORS_ALLOWED_ORIGINS=          # Origins allowed to call core-api with a Bearer token, comma-separated (local: the teacher app on Expo web, http://localhost:8081). The web app uses its own origin
AWS_ENDPOINT_URL=              # aws-local for SNS/SQS (http://localhost:4566); empty = the real AWS endpoints
QUEUE_PROVIDER=                # sqs | pubsub (OD-31)
EVENTS_TOPIC=                  # Event topic
QUEUE_NOTIFICATIONS=           # QUEUE_<CONSUMER>: one queue per consumer group
DLQ_NOTIFICATIONS=             # DLQ_<CONSUMER>: one dead-letter queue per consumer group
QUEUE_PLATFORM_DEMO=
DLQ_PLATFORM_DEMO=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_SIGNING_KEY_ID=            # The key itself stays in the secrets manager
JWT_SIGNING_KEY=               # local only: HMAC key for access tokens (base64, 32+ bytes). Elsewhere the secrets manager holds it
ACCESS_TOKEN_TTL=              # 15 min (MKT-ACC-04)
REFRESH_TOKEN_TTL=             # 30 days (MKT-ACC-04)
OPS_OIDC_ISSUER=               # Locally the oidc-stub (not yet built, E1-06)
OPS_OIDC_CLIENT_ID=
OPS_IP_ALLOWLIST=
PAYMENT_PROVIDER=              # paymob | fawry | kashier | fake (fake is refused when APP_ENV=prod)
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
HOLD_SECONDS=                  # seat hold for card and wallet, default 600 (BR-ENR-01)
FAWRY_HOLD_SECONDS=            # seat hold and Fawry reference life, default 86400 (OD-09)
PAYOUT_PROVIDER=
PAYOUT_API_KEY=
PAYOUT_WEBHOOK_SECRET=
SMS_PROVIDER=                  # fake locally (sms-sink); OD-45
SMS_API_KEY=
SMS_SENDER_ID=
EKYC_PROVIDER=                 # OD-47
EKYC_API_KEY=
EKYC_WEBHOOK_SECRET=
MAPS_PROVIDER=                 # fake locally; OD-46
MAPS_API_KEY=
MAPS_MONTHLY_CAP=
PUSH_FCM_CREDENTIALS=
PUSH_APNS_KEY_ID=
PUSH_APNS_TEAM_ID=
EMAIL_PROVIDER=                # fake locally (mail-sink); the landing's pilot form uses resend (ADR-0009)
EMAIL_API_KEY=                 # Resend API key (landing pilot requests); empty = print a redacted line instead
EMAIL_FROM=                    # default "Link <onboarding@resend.dev>" (delivers only to the Resend account's own address)
PILOT_REQUEST_TO=              # where landing-page pilot requests are emailed (Ahmed's address)
WHATSAPP_PHONE_NUMBER_ID=      # Phase 2
WHATSAPP_TOKEN=
WHATSAPP_WEBHOOK_SECRET=
AI_SERVICE_URL=
AI_SERVICE_AUDIENCE=

# ── ai-service ─────────────────────────────────────────────────────────────────
CORE_API_URL=                  # Write-back through core-api only
STT_PROVIDER=                  # fake locally (E15-03 chooses the vendor)
STT_API_KEY=
LLM_PROVIDER=                  # fake locally
LLM_API_KEY=
MODEL_ROUTING_CONFIG=          # JSON or a .json path: {"stt":{"provider":"local-whisper","model":"large-v3-turbo","device":"auto"},"llm":{"provider":"ollama","model":"qwen3:8b"}}
AI_SERVICE_TOKEN=              # Shared secret between ai-service and the pilot / mock server (pnpm pilot:start and pnpm demo set a fresh one)
AI_SERVICE_HOST=               # 127.0.0.1 only (ai-service refuses anything else)
AI_SERVICE_PORT=               # default 8090
AI_MODELS_DIR=                 # Whisper models, default apps/ai-service/.models (pnpm ai:models)
OLLAMA_URL=                    # default http://127.0.0.1:11434 (local LLM for extraction)
AI_USAGE_LOG=                  # JSON lines per STT/LLM call (task, model, data class, seconds; no text)
AI_JOB_TIMEOUT_S=              # default 180: a note not processed by then shows "Type the note instead"
AI_LLM_BUDGET_S=               # default 90: the LLM step's share of a note (all attempts); after it the note keeps rule results only
AI_PRELOAD=                    # default 1: load the Whisper model at start; pnpm demo sets 0 unless real speech-to-text was left on
AI_SCORE_PREFILL=               # 1 = a sure voice score may be pre-filled (demo). Default 0: always "check" (pilot, until the audio eval shows score exact match >= 95%)
AI_BUDGET_DEFAULT_PER_CENTRE=
EVAL_GOLD_SET_URI=

# ── Web apps and teacher app ───────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_DEFAULT_LOCALE=    # ar
NEXT_PUBLIC_MAPS_KEY=
NEXT_PUBLIC_POSTHOG_KEY=       # website analytics: page views + the two landing buttons, no cookies (empty = off)
NEXT_PUBLIC_POSTHOG_HOST=      # default https://eu.i.posthog.com
NEXT_PUBLIC_SITE_URL=          # public address for canonical links and social cards (default http://localhost:3000)
NEXT_PUBLIC_CONTACT_WHATSAPP=  # Link's WhatsApp number, international form (e.g. 2010…); empty until chosen: the landing buttons go to the form
NEXT_PUBLIC_CONTACT_EMAIL=     # Link's public contact address: footer "Contact", the request confirmation, and where requests go if PILOT_REQUEST_TO is empty
NEXT_PUBLIC_TEACHER_APP_URL=   # where "Try it as a teacher" opens the teacher app (default http://localhost:8081)
NEXT_PUBLIC_USE_MOCKS=         # true | false (older switch; false = live). NEXT_PUBLIC_API_MODE wins when set
NEXT_PUBLIC_API_MODE=          # mock (default, MSW in the browser) | mock-server (pnpm mock:server) | live
NEXT_PUBLIC_APP_ENV=           # local enables the dev-only Demo controls (with NEXT_PUBLIC_DEMO_CONTROLS=1)
NEXT_PUBLIC_DEMO_CONTROLS=     # 1 = show Demo controls (local + mock modes only; never in production builds)
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_SITE_URL=          # the website, for "Reset demo" and the pilot card in the teacher app (default http://localhost:3000)
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_USE_MOCKS=         # true | false (older switch; false = live)
EXPO_PUBLIC_API_MODE=          # mock (default) | mock-server | live
EXPO_PUBLIC_APP_ENV=           # local enables Demo controls (with EXPO_PUBLIC_DEMO_CONTROLS=1)
EXPO_PUBLIC_DEMO_CONTROLS=     # 1 = show Demo controls (dev builds only)

# ── Shared demo mock server (pnpm mock:server, pnpm demo) ──────────────────────
MOCK_SERVER_PORT=              # default 4010
MOCK_SERVER_URL=               # default http://localhost:4010 (scenario script)
DEMO_DEFAULT_FLAGS=            # phase2-only (pnpm demo) = Phase 2 on, marketplace off on the first run; empty = both on
DEMO_AI=                       # 0 = pnpm demo does not start ai-service (the e2e configs set it: they use the fixtures)
DEMO_WARM_WAIT_S=              # demo:warm waits this many seconds for the three demo servers first (the demo e2e sets 300)
LANDING_URL=                   # scripts/landing-compare.mjs: the web app to compare with Figma (default http://localhost:3000)

# ── Local infrastructure only (infra/local/docker-compose.yml) ─────────────────
POSTGRES_PASSWORD=             # Container superuser; never used by the apps
APP_MIGRATOR_PASSWORD=         # app_migrator, created by the container init script
APP_USER_PASSWORD=             # Set on the app roles by `pnpm db:migrate` (local only)
APP_WORKER_PASSWORD=
APP_OPS_PASSWORD=
POSTGRES_HOST_PORT=            # Host port for postgres (default 5432)
REDIS_CACHE_HOST_PORT=         # default 6379
REDIS_STATE_HOST_PORT=         # default 6380
AWS_LOCAL_HOST_PORT=           # default 4566 (Moto; stands in for LocalStack, ADR-0006)
SMS_SINK_HOST_PORT=            # default 8093 (8090 is ai-service, 8092 the oidc-stub)
SMS_SINK_URL=                  # Where the fake SmsSender posts
MAIL_SINK_HOST_PORT=           # default 8025 (web UI)
MAIL_SINK_SMTP_HOST_PORT=      # default 1025
FAKE_PAY_HOST_PORT=            # default 8091
FAKE_PAY_URL=                  # Where the fake PaymentProvider calls
FAKE_PAY_WEBHOOK_URL=          # Where fake-pay posts webhooks (core-api)
AWS_ACCESS_KEY_ID=             # Dummy values for aws-local
AWS_SECRET_ACCESS_KEY=

# ── Concierge pilot (apps/pilot, docs/pilot/runbook.md) ─────────────────────────
# Keep this laptop's values in apps/pilot/.env.pilot (git-ignored). Nothing secret goes here:
# PIN hashes and sessions live in the state file on the encrypted drive.
LINK_MODE=                     # pilot = the pilot server (demo routes, fixtures and demo users refused)
NEXT_PUBLIC_LINK_MODE=         # pilot = owner web pilot build (set by pnpm pilot:build)
EXPO_PUBLIC_LINK_MODE=         # pilot = teacher app pilot build (set by pnpm pilot:build)
NEXT_DIST_DIR=                 # .next-pilot for the pilot build (default .next)
PILOT_DATA_DIR=                # Folder on the BitLocker-encrypted drive (state, activity log, keys)
PILOT_BACKUP_DIR=              # default <PILOT_DATA_DIR>/backups (48 kept)
PILOT_BIND=                    # The centre LAN address of this laptop, e.g. 192.168.1.15 (never 0.0.0.0)
PILOT_WEB_PORT=                # default 8443 (owner web)
PILOT_TEACHER_PORT=            # default 8444 (teacher app)
PILOT_LOCAL_HTTP=              # 0 = no plain HTTP on 127.0.0.1 (default on, for the laptop itself)
PILOT_TLS_CERT=                # default <PILOT_DATA_DIR>/tls/server.crt (pnpm pilot:cert)
PILOT_TLS_KEY=                 # default <PILOT_DATA_DIR>/tls/server.key
PILOT_SESSION_HOURS=           # Sign-in session length, default 12
PILOT_WEB_UPSTREAM=            # The owner web's Next.js server, default http://127.0.0.1:3100
PILOT_TEACHER_DIST=            # default apps/teacher-app/dist-pilot
PILOT_ALLOWED_ORIGINS=         # Extra allowed origins, comma-separated (default: the pilot's own)
PILOT_SKIP_BUNDLE_CHECK=       # 1 = tests only: skip the app-bundle scan at start-up
PILOT_VOICE=                   # 1 = voice notes on (Part B; still per teacher: signed consent recorded by the owner)
PILOT_E2E_VOICE=               # 1 = run the opt-in pilot voice e2e (apps/pilot/e2e/voice.spec.ts; needs the models and Ollama)
PILOT_PRACTICE_DIR=             # pilot:practice: the training centre folder (default: <PILOT_DATA_DIR>-practice; never the real data)
DEMO_WEB_URL=                  # pnpm demo:warm, default http://localhost:3000
DEMO_TEACHER_URL=              # pnpm demo:warm, default http://localhost:8081
I18N_MESSAGES_DIR=             # Tests only: messages folder for i18n:apply-review
TEST_LOG=                      # Tests only: core-api log level in pnpm test:api / test:rls (default silent)
E2E_MODE=                      # Tests only: mock (default) | live — which stack apps/web/e2e-modes runs against (pnpm test:e2e:mock / test:e2e:live)
LIVE_STORY_STEPS=              # Tests only: how far the connected story runs in live mode (R2a: 3, R2b: 7, R3: 9)
INIT_CWD=                      # Set by pnpm itself (where the command was run); not configured by hand
PATH=                          # The system PATH (ai-service adds the CUDA libraries to it on Windows); not configured by hand
