# Link on one server — deploy/.env.production (copy of this file; never commit it).
# Names and purpose only. `pnpm prod:env` writes deploy/.env.production with fresh random secrets
# for every *_PASSWORD / *_KEY / *_SECRET below; you then fill in the domain and the providers.
# What each setting switches: docs/go-live-switches.md. How to run: docs/operations.md.

# ── Deployment ────────────────────────────────────────────────────────────────────────────────
LINK_ENV=                    # production (real users; the guard refuses every fake) | staging (pnpm prod:local)
APP_ENV=                     # prod (with LINK_ENV=production) | staging
LINK_DOMAIN=                 # e.g. link.example.com — Caddy gets its HTTPS certificate automatically
ACME_EMAIL=                  # Let's Encrypt contact for the certificate
LINK_VERSION=                # image tag (default local)
LOG_LEVEL=                   # info
WEB_APP_ENV=                 # production (default) | staging

# ── Database and Redis (on this server) ───────────────────────────────────────────────────────
POSTGRES_PASSWORD=           # superuser, used only by the container itself
APP_MIGRATOR_PASSWORD=       # owner of the schema; migrations run as it
APP_USER_PASSWORD=           # core-api requests (RLS applies)
APP_WORKER_PASSWORD=         # worker and gateway
APP_OPS_PASSWORD=            # ops console (S2)

# ── Keys (32 random bytes, base64 — keep a copy with the backups: without them the data is unreadable)
FIELD_KEY=                   # encrypts phones and bank details in the database
HMAC_KEY_LOOKUP=             # finds a phone without decrypting it (never change it after launch)
STORAGE_KEY=                 # encrypts voice audio on disk (STORAGE_PROVIDER=file)
JWT_SIGNING_KEY=             # signs session tokens
JWT_SIGNING_KEY_ID=          # e.g. prod-2026-10 (change with the key; old sessions end)
JWT_ISSUER=                  # https://<LINK_DOMAIN>
JWT_AUDIENCE=                # link

# ── Web ───────────────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=        # https://<LINK_DOMAIN> (where the payment page sends parents back)
CORS_ALLOWED_ORIGINS=        # only for a teacher app on another origin; empty is fine on one domain
NEXT_PUBLIC_CONTACT_EMAIL=   # shown on the site
EMAIL_API_KEY=               # pilot-request emails (Resend); empty = printed to the log
EMAIL_FROM=
PILOT_REQUEST_TO=

# ── Providers (docs/go-live-switches.md; provider choice: docs/plan/provider-choice.md) ───────
PAYMENT_PROVIDER=            # none (bookings off: a Follow-up-only pilot) | the real one once its adapter exists
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
SMS_PROVIDER=                # the real SMS adapter (sign-in codes) — required for real users
SMS_API_KEY=
SMS_SENDER_ID=
WHATSAPP_PROVIDER=           # manual (staff send, "I sent it") until the WhatsApp adapter exists
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_SECRET=

# ── Voice notes (optional: docker compose --profile ai) ───────────────────────────────────────
AI_SERVICE_URL=              # http://ai:8090 with the ai profile; empty = "Type the note instead"
AI_SERVICE_TOKEN=            # 24+ random characters, shared by core-api and ai-service
OLLAMA_URL=                  # a local Ollama for extraction help and Ask Link; empty = off

# ── Storage ───────────────────────────────────────────────────────────────────────────────────
STORAGE_PROVIDER=            # file (default: an encrypted folder on this server) | s3
S3_ENDPOINT=                 # s3 only: an S3-compatible endpoint (R2, AWS)
S3_REGION=
S3_BUCKET_VOICE=
S3_SSE=                      # kms | aes256 | none (R2 encrypts by itself)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Monitoring and backups (docs/operations.md) ───────────────────────────────────────────────
SENTRY_DSN=                  # optional error tracking; empty = off
BACKUP_DIR=                  # deploy/backup.sh writes here (default /var/backups/link)
BACKUP_KEEP=                 # how many nightly copies to keep (default 14)
BACKUP_PASSPHRASE=           # encrypts every backup (store it apart from the server)
BACKUP_S3_URI=               # optional: s3://bucket/path for an off-server copy (needs the aws CLI)
