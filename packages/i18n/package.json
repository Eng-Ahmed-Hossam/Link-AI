    "test": "vitest run",
    "i18n:check": "node scripts/check-keys.mjs"
  },
  "devDependencies": {
    "@link/config": "workspace:*",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "^3.5.20",
    "intl-messageformat": "^12.1.2"
  }
}
