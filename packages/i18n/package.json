{
  "name": "@link/i18n",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./locale": "./src/locale.ts",
    "./format": "./src/format.ts",
    "./names": "./src/names.ts",
    "./messages/*": "./messages/*"
  },
  "scripts": {
    "typecheck": "tsc -p .",
