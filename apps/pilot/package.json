{
  "name": "@link/pilot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Concierge pilot server: the follow-up loop on one laptop at the centre (docs/pilot).",
  "scripts": {
    "start": "tsx src/server.ts",
    "init": "tsx src/cli/init.ts",
    "import": "tsx src/cli/import.ts",
    "wipe": "tsx src/cli/wipe.ts",
    "metrics": "tsx src/cli/metrics.ts",
    "backup": "tsx src/cli/backup.ts",
    "restore": "tsx src/cli/restore.ts",
    "cert": "tsx src/cli/cert.ts",
    "reset-pin": "tsx src/cli/reset-pin.ts",
    "check": "tsx src/cli/check.ts",
    "build:apps": "node scripts/build-apps.mjs",
    "typecheck": "tsc -p .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@link/api-client": "workspace:*",
    "@link/mocks": "workspace:*",
    "msw": "^3.0.1",
    "node-forge": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@link/config": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.1",
    "@types/node-forge": "^1.3.14",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  }
}
