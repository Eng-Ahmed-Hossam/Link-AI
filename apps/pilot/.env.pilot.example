# Copy to apps/pilot/.env.pilot (git-ignored) on the pilot laptop. docs/pilot/runbook.md, step 3.
# Nothing secret here: PIN hashes and sessions live in the state file on the encrypted drive.

# A folder on the BitLocker-encrypted drive. Pilot data, the activity log, backups and keys live here.
PILOT_DATA_DIR=C:\LinkPilot\data

# This laptop's address on the centre Wi-Fi (ipconfig → "IPv4 Address"). Never 0.0.0.0.
PILOT_BIND=192.168.1.15

# Defaults; change only if a port is taken.
PILOT_WEB_PORT=8443
PILOT_TEACHER_PORT=8444
PILOT_SESSION_HOURS=12

# Part B: voice notes (local speech-to-text + LLM on this laptop; docs/pilot/runbook.md §1b).
# 1 = on. Still per teacher: the owner records each teacher's signed voice consent in Staff & access.
PILOT_VOICE=0
# Optional. On a laptop without an NVIDIA GPU, a smaller LLM (ADR-0007):
# MODEL_ROUTING_CONFIG={"llm":{"model":"qwen3:4b"}}
